APP_NAME="Grafista Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────
# DATABASE
#
# Default: MySQL (XAMPP).
#   1. Start MySQL di XAMPP Control Panel
#   2. Buat database:  CREATE DATABASE membership;
#   3. php artisan migrate --seed
#
# Alternatif tanpa MySQL (SQLite, cocok untuk quick test):
#   DB_CONNECTION=sqlite
#   (hapus/komentari baris DB_* MySQL di bawah)
# ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=membership
DB_USERNAME=root
DB_PASSWORD=

# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# ─────────────────────────────────────────────────────────────
# MAYAR — Payment Gateway
#
# sandbox : simulasi lokal (tanpa API key). Invoice otomatis
#           berstatus "paid" setelah 15 detik — cocok untuk
#           development & demo.
# mayar   : produksi. Isi MAYAR_API_KEY, lalu set webhook URL
#           di dashboard Mayar:  https://domain-anda/api/webhooks/mayar
#           dan isi MAYAR_WEBHOOK_SECRET dengan secret yang sama.
# ─────────────────────────────────────────────────────────────
MAYAR_DRIVER=sandbox
MAYAR_BASE_URL=https://api.mayar.id
MAYAR_API_KEY=
# Opsional — hanya bila slot webhook akun Mayar diarahkan ke backend ini.
# Konfirmasi pembayaran utamanya via polling API (aman walau webhook dipakai website lain).
MAYAR_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# CLOUDFLARE R2 — storage file produk (opsional)
#
# Setup lengkap: lihat bagian "Storage — Cloudflare R2" di README.
# Setelah diisi, verifikasi dengan:  php artisan r2:check
#
# Isi 3 nilai di bawah (R2_BUCKET bebas nama) untuk mengaktifkan
# upload file produk. Bucket sebaiknya private — backend yang
# mengeluarkan presigned URL (berlaku sementara) saat member
# menekan tombol Download.
# JANGAN LUPA: set CORS policy di bucket (Settings → CORS policy)
# agar upload dari browser diizinkan — contoh JSON ada di README.
# Kosongkan R2_ACCESS_KEY untuk menonaktifkan fitur upload
# (admin tetap bisa memakai "Link Eksternal" seperti Google Drive).
#
# Cara dapatkan nilai:
#   R2_ACCOUNT_ID : dashboard Cloudflare → R2 → kanan atas
#   R2_ACCESS_KEY : R2 → Manage R2 API Tokens → Create API Token
#                   (permission: Object Read & Write)
# ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=grafista-products

# ─────────────────────────────────────────────────────────────
# PROGRAM POIN — WAJIB identik dengan frontend
# (frontend: src/config/index.ts, backend: config/points.php)
#
# POINTS_EARN_RATE        : Rp berapa untuk 1 poin  (Rp1.000 = 1 poin)
# POINTS_REDEEM_VALUE     : 1 poin = Rp berapa      (1 poin = Rp10)
# POINTS_MIN_REDEEM       : minimum poin untuk redeem
# POINTS_MAX_REDEEM_PERCENT: maksimum % harga yang boleh ditutup poin
# ─────────────────────────────────────────────────────────────
POINTS_EARN_RATE=1000
POINTS_REDEEM_VALUE=10
POINTS_MIN_REDEEM=100
POINTS_MAX_REDEEM_PERCENT=50

# Origin frontend untuk CORS (Vite dev server).
# Bisa beberapa domain dipisah koma — entri PERTAMA adalah domain utama
# (member area) yang dipakai untuk redirect pembayaran Mayar & CORS R2.
# Contoh produksi multi-domain:
#   FRONTEND_URL=https://member.grafistadigital.com,https://grafistadigital.com
FRONTEND_URL=http://localhost:5173
