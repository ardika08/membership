# URL base API Laravel. Sesuaikan dengan environment kamu.
VITE_API_BASE_URL=http://localhost:8000/api

# Set ke "false" setelah backend Laravel siap, agar frontend memanggil API asli
# alih-alih mock adapter di src/api/services.ts
VITE_USE_MOCK_API=true

# ── Setup multi-domain (opsional) ─────────────────────────────
# Isi keduanya HANYA jika katalog dan member area dipisah domain,
# contoh:
#   VITE_PUBLIC_URL=https://grafistadigital.com
#   VITE_MEMBER_URL=https://member.grafistadigital.com
#
# Kosongkan keduanya (default) untuk mode satu domain / dev lokal.
VITE_PUBLIC_URL=
VITE_MEMBER_URL=
