# Konfigurasi frontend untuk build produksi (multi-domain).
#
#   grafistadigital.com       → katalog publik
#   member.grafistadigital.com → dashboard member & admin
#   api.grafistadigital.com    → backend Laravel
#
# Build sekali, upload dist/ yang sama ke kedua domain
# (public_html dan docroot subdomain member).

VITE_API_BASE_URL=https://api.grafistadigital.com/api

# Domain publik (katalog). Kosongkan untuk mode satu domain.
VITE_PUBLIC_URL=https://grafistadigital.com

# Domain member (dashboard, login, admin). Kosongkan untuk mode satu domain.
VITE_MEMBER_URL=https://member.grafistadigital.com
