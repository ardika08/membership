# Konfigurasi frontend untuk build produksi.
#
# VITE_API_BASE_URL = alamat API backend Laravel yang sudah di-deploy.
#
# Contoh jika API di subdomain:
#   VITE_API_BASE_URL=https://api.domainkamu.com/api
#
# Contoh jika API satu domain dengan frontend (backend di subfolder /api):
#   VITE_API_BASE_URL=https://domainkamu.com/api
#
# Ganti URL di bawah dengan domain kamu sebelum menjalankan:
#   npm run build
VITE_API_BASE_URL=https://GANTI-DENGAN-DOMAIN-ANDA/api
